# ===== 敏感配置（含数据库密码，严禁入库）=====
inc/config.local.php

# ===== 本地开发辅助（含服务器信息/测试凭据，不入库）=====
dev/

# ===== 自动上传工具（二进制与含凭据的本地配置）=====
autoupload/*.exe
autoupload/*.ini
autoupload/*.png
autoupload/test-*

# ===== 依赖与构建产物 =====
web/node_modules/
web/dist/

# ===== 运行时数据（部署服务器上生成）=====
storage/
pub/
*.log

# ===== 编辑器与系统 =====
.idea/
.vscode/
Thumbs.db
.DS_Store
